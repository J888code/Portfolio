def remove_duplicates(items: list) -> list:
    """
    Remove duplicates while preserving order.
    
    Input: [1, 2, 2, 3, 3, 3, 4]
    Output: [1, 2, 3, 4]
    
    HINT: Use set + preserve order
    """
    seen = set()
    result = []
    for item in items:
        if item not in seen:
            seen.add(item)
            result.append(item)
    return result

# Test
assert remove_duplicates([1, 2, 2, 3, 3, 3, 4]) == [1, 2, 3, 4]
assert remove_duplicates(["a", "b", "b", "c"]) == ["a", "b", "c"]
